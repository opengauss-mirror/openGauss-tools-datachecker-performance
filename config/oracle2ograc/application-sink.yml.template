# ============================================================================
# oGRAC sink configuration template for Oracle-to-oGRAC check
# BEFORE STARTUP, replace ALL placeholders in this file, otherwise the service
# fails at startup (Druid connects to the database eagerly):
#   <host>:<port>   database address, e.g. 192.168.0.10:1611
#   <schema>        oGRAC user (owner) of the tables to check
#   <password>      login password
#   kafka bootstrap-servers and debezium-avro-registry addresses as well
# ============================================================================
server:
  port: 9002
logging:
  config: config/log4j2.xml
spring:
  check:
    server-uri: http://127.0.0.1:9000
    core-pool-size: 4
    maximum-pool-size: 4
    maximum-topic-size: 4
    # Maximum rows per slice; tables exceeding this row count are split into multiple slices; must be identical on both ends
    maximum-table-slice-size: 5000
    extend-maximum-pool-size: 4
  extract:
    schema: <schema> # oGRAC user (owner) of the tables to check; letters, digits, underscore, '$' and '#' only, length 1~64
    databaseType: OGRAC # oGRAC sink for Oracle-to-oGRAC check; Oracle-compatible mode only
    query-dop: 8 # jdbc Parallel Query  config
    # Memory safe watermark ratio (of -Xmx), reserving headroom for GC jitter and short peaks; default 0.30.
    memory-safe-watermark: 0.30
    # Minimum concurrent slices: on small heaps or at high watermark, keep at least this many slices running to avoid "all rejected -> deadlock". Default 1, enforced minimum 1.
    memory-min-concurrency: 1
    debezium-enable: false # no need config,but not delete
    debezium-topic:  # no need config,but not delete
    debezium-groupId:  # no need config,but not delete
    debezium-serializer: AvroSerializer # StringSerializer or AvroSerializer
    debezium-avro-registry: http://<host>:<port> # avro schema registry
    debezium-time-period: 1 # no need config,but not delete
    debezium-num-period: 1000 # no need config,but not delete

  jdbc:
    result-set:
      # Automatically reduced at runtime based on remaining heap memory; configured here as the upper limit. Can be raised if memory is sufficient
      fetch-size: 1000

  kafka:
    bootstrap-servers: <host>:<port>
    # Producer tuning (passed through to the Kafka client; remove this block to fall back to client defaults)
#    properties:
#      # Old broker version (<3.0): idempotence and in-flight>5 are mutually exclusive, so idempotence is explicitly disabled for a deeper pipeline
#      linger.ms: 30
#      # Supported compression: none (default) / gzip / snappy; lz4 is NOT bundled in this release, do not configure it
#      compression.type: snappy
#      max.in.flight.requests.per.connection: 20
#      enable.idempotence: false
#    producer:
#      batch-size: 1048576
#      # Producer send buffer, occupies heap memory; must be smaller than -Xmx
#      buffer-memory: 67108864
  datasource:
    driver-class-name: org.opengauss.Driver
    url: jdbc:oGRAC://<host>:<port>
    username: <schema>
    password: '<password>' # The password text may contain special characters, which need to be enclosed in quotation marks
    # Configure pool size; initial-size and min-idle are derived from max-active
    # Users can make appropriate adjustments according to the number of current database tables
    druid:
      max-active: 8 # maximum number of connections
      test-while-idle: true
      test-on-borrow: true
      validation-query: "select 1"
      validation-query-timeout: 10000
      connection-error-retry-attempts: 0
      break-after-acquire-failure: true
      max-wait: 600000
      keep-alive: true
      min-evictable-idle-time-millis: 600000
data:
  check:
    # Oracle/oGRAC precision mode: COMPATIBLE (kernel compatible, default) or STRICT (exact comparison)
    # Must be identical to the source side
    oracle2ograc:
      precision-mode: COMPATIBLE
